{
  "name": "meshstream",
  "version": "0.1.0",
  "private": true,
  "description": "Peer-assisted live streaming in the browser",
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "postcss": "8.5.31"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,signal,web -c magenta,green,cyan \"npm:dev:api\" \"npm:dev:signal\" \"npm:dev:web\"",
    "dev:web": "npm run dev -w @meshstream/web",
    "dev:api": "npm run dev -w @meshstream/api",
    "dev:signal": "npm run dev -w @meshstream/signal",
    "build": "npm run build -w @meshstream/web",
    "typecheck": "npm run typecheck -w @meshstream/api && npm run typecheck -w @meshstream/signal && npm run typecheck -w @meshstream/web",
    "start": "concurrently -k -n api,signal,web -c magenta,green,cyan \"npm:start:api\" \"npm:start:signal\" \"npm:start:web\"",
    "start:web": "npm run start -w @meshstream/web",
    "start:api": "npm run start -w @meshstream/api",
    "start:signal": "npm run start -w @meshstream/signal",
    "media:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-media.ps1",
    "media:start": "powershell -ExecutionPolicy Bypass -File scripts/start-media.ps1",
    "media": "npm run media:start",
    "caddy": "powershell -ExecutionPolicy Bypass -File scripts/run-caddy.ps1",
    "tunnel": "powershell -ExecutionPolicy Bypass -File scripts/start-tunnel.ps1",
    "up": "powershell -ExecutionPolicy Bypass -File scripts/start-all.ps1",
    "services:install": "powershell -ExecutionPolicy Bypass -File scripts/install-services.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.2"
  }
}
