# MeshStream environment reference.
#
# Development defaults work with no .env at all:
#   web http://localhost:3000, API :4000, signal :4001,
#   MediaMTX HLS :8888, MediaMTX WHIP :8889.
#
# Leave NEXT_PUBLIC_API_URL / NEXT_PUBLIC_SIGNAL_URL unset unless you are
# deliberately splitting the web app from the API. When unset, the browser
# uses localhost ports in dev and the same origin behind Caddy in production.

# --- optional public endpoints (commented = auto) ---
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_SIGNAL_URL=ws://localhost:4001

# --- api ---
PORT=4000
# Change these three before exposing the tunnel to other people.
COOKIE_SECRET=dev-only-change-me-please-32-chars-min
PLAYBACK_SECRET=dev-only-playback-secret-change-me
INTERNAL_SECRET=dev-only-internal-secret
MEDIA_HLS_ORIGIN=http://127.0.0.1:8888
MEDIA_WHIP_ORIGIN=http://127.0.0.1:8889
SIGNAL_STATS_URL=http://127.0.0.1:4001
DATA_DIR=./data
REQUIRE_PLAYBACK_TOKEN=true
ORIGIN_BUDGET_MBPS=12
# Set to your stable public origin only if you split web and API.
# WEB_ORIGIN=https://stream.example.com
# Set true when the app is only served over HTTPS. Leave false for localhost.
# COOKIE_SECURE=false

# --- signal ---
SIGNAL_PORT=4001
API_INTERNAL_URL=http://127.0.0.1:4000
